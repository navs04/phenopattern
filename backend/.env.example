# Copy to .env for local use. Nothing here is secret; there are no API keys in this project.
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
# Optional: allow Vercel preview deployments (regex is matched against the WHOLE origin)
# CORS_ORIGIN_REGEX=https://phenopattern-[a-z0-9-]+\.vercel\.app
RATE_DEFAULT_PER_MIN=120
RATE_SEARCH_PER_MIN=180
RATE_MATCH_PER_MIN=20
# Only set to true behind a proxy you trust (see DEPLOYMENT.md); the header is otherwise spoofable.
TRUST_PROXY_HEADERS=false
